FROM maxvera-phase0:codeql

ARG DEBIAN_FRONTEND=noninteractive
ARG PYTHON_VERSION=3.10
ARG PIP_VERSION=24.3.1
ARG TORCH_VERSION=2.5.0
ARG TRANSFORMERS_VERSION=4.46.3
ARG ACCELERATE_VERSION=1.1.1

# The patched CodeQL bundle is inherited from maxvera-phase0:codeql.  IRIS
# writes generated QL packs into that tree, so the runtime launcher copies it
# into the ephemeral workspace instead of modifying /opt/codeql in place.
RUN test -x /opt/codeql/codeql \
    && /opt/codeql/codeql version --format=terse

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3.10 \
        python3.10-venv \
    && rm -rf /var/lib/apt/lists/* \
    && python${PYTHON_VERSION} -m venv /opt/iris-venv \
    && /opt/iris-venv/bin/python -m pip install --no-cache-dir \
        "pip==${PIP_VERSION}" \
    && /opt/iris-venv/bin/python -m pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cu124 \
        "torch==${TORCH_VERSION}" \
    && /opt/iris-venv/bin/python -m pip install --no-cache-dir \
        "accelerate==${ACCELERATE_VERSION}" \
        "numpy==1.26.4" \
        "openai==1.54.4" \
        "pandas==2.2.3" \
        "requests==2.32.3" \
        "tqdm==4.67.1" \
        "transformers==${TRANSFORMERS_VERSION}" \
    && /opt/iris-venv/bin/python -c \
        "import torch, transformers; assert torch.__version__.startswith('${TORCH_VERSION}'); assert transformers.__version__ == '${TRANSFORMERS_VERSION}'"

COPY run-iris.sh /opt/maxvera/run-iris.sh
RUN chmod 0555 /opt/maxvera/run-iris.sh

ENV PATH="/opt/iris-venv/bin:${PATH}" \
    HF_HOME=/cache/huggingface \
    TOKENIZERS_PARALLELISM=false \
    PYTHONUNBUFFERED=1

ENTRYPOINT []
CMD ["/opt/maxvera/run-iris.sh", "--help"]

LABEL org.opencontainers.image.title="MaxVera Phase 0 IRIS local runtime" \
      org.opencontainers.image.version="iris-v1-python3.10-torch2.5.0-cu124" \
      org.opencontainers.image.source="https://github.com/iris-sast/iris" \
      org.maxvera.iris.python.version="3.10" \
      org.maxvera.iris.torch.version="2.5.0" \
      org.maxvera.iris.torch.cuda="12.4" \
      org.maxvera.iris.transformers.version="4.46.3"
