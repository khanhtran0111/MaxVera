{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxvera.local/schemas/runtime_manifest_record.schema.json",
  "title": "Leakage-resistant runtime manifest JSONL record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "instance_id",
    "snapshot_id",
    "track",
    "repository",
    "revision",
    "build"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "instance_id": {"type": "string", "pattern": "^oi_[0-9a-f]{32}$"},
    "snapshot_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "track": {"enum": ["legacy", "v2"]},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "owner", "name", "url"],
      "properties": {
        "host": {"const": "github.com"},
        "owner": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$"},
        "name": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$"},
        "url": {"type": "string", "format": "uri"}
      }
    },
    "revision": {
      "type": "string",
      "pattern": "^([0-9a-f]{40})?$"
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "jdk_version",
        "maven_version",
        "gradle_version",
        "use_gradle_wrapper"
      ],
      "properties": {
        "status": {"type": "string", "minLength": 1},
        "jdk_version": {"type": "string"},
        "maven_version": {"type": "string"},
        "gradle_version": {"type": "string"},
        "use_gradle_wrapper": {"type": "string"}
      }
    }
  }
}
