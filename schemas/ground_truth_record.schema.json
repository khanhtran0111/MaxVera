{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxvera.local/schemas/ground_truth_record.schema.json",
  "title": "Evaluator-only ground-truth JSONL record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "instance_id",
    "upstream_id",
    "project_slug",
    "cve_id",
    "cwe_id",
    "cwe_name",
    "advisory_id",
    "repository_tag",
    "buggy_commit_id",
    "fix_commit_ids",
    "fix_locations",
    "manual_source_sink_annotations"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "instance_id": {"type": "string", "pattern": "^oi_[0-9a-f]{32}$"},
    "upstream_id": {"type": "string", "minLength": 1},
    "project_slug": {"type": "string", "minLength": 1},
    "cve_id": {"type": "string", "pattern": "^CVE-[0-9]{4}-[0-9]+$"},
    "cwe_id": {"type": "string", "pattern": "^CWE-[0-9]+$"},
    "cwe_name": {"type": "string", "minLength": 1},
    "advisory_id": {"type": "string"},
    "repository_tag": {"type": "string", "minLength": 1},
    "buggy_commit_id": {"type": "string", "pattern": "^([0-9a-f]{40})?$"},
    "fix_commit_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/gitRevision"}
    },
    "fix_locations": {
      "type": "array",
      "items": {"$ref": "#/$defs/fixLocation"}
    },
    "manual_source_sink_annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {"type": "string"}
      }
    }
  },
  "$defs": {
    "gitRevision": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
    "nullableLine": {
      "oneOf": [
        {"type": "integer", "minimum": 1},
        {"type": "null"}
      ]
    },
    "fixLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "file",
        "class",
        "class_start",
        "class_end",
        "method",
        "method_start",
        "method_end",
        "signature"
      ],
      "properties": {
        "commit": {"$ref": "#/$defs/gitRevision"},
        "file": {"type": "string", "minLength": 1},
        "class": {"type": "string"},
        "class_start": {"$ref": "#/$defs/nullableLine"},
        "class_end": {"$ref": "#/$defs/nullableLine"},
        "method": {"type": "string"},
        "method_start": {"$ref": "#/$defs/nullableLine"},
        "method_end": {"$ref": "#/$defs/nullableLine"},
        "signature": {"type": "string"}
      }
    }
  }
}
