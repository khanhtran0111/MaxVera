{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxvera.local/schemas/baseline_record.schema.json",
  "title": "Phase 0 per-project baseline record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "baseline",
    "track",
    "project",
    "cve",
    "cwe",
    "query",
    "status",
    "number_of_paths",
    "vulnerability_detected",
    "runtime_seconds",
    "exit_code",
    "command_record",
    "output_artifacts",
    "error",
    "metadata"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "baseline": {"enum": ["codeql", "iris"]},
    "track": {"enum": ["legacy", "v2"]},
    "project": {"type": "string", "minLength": 1},
    "cve": {
      "oneOf": [
        {"type": "string", "pattern": "^CVE-[0-9]{4}-[0-9]+$"},
        {"type": "null"}
      ]
    },
    "cwe": {
      "oneOf": [
        {"type": "string", "pattern": "^CWE-[0-9]+$"},
        {"type": "null"}
      ]
    },
    "query": {"type": "string", "minLength": 1},
    "status": {"enum": ["COMPLETE", "FAILED", "TIMEOUT"]},
    "number_of_paths": {
      "oneOf": [
        {"type": "integer", "minimum": 0},
        {"type": "null"}
      ]
    },
    "vulnerability_detected": {
      "oneOf": [
        {"type": "boolean"},
        {"type": "null"}
      ]
    },
    "runtime_seconds": {"type": "number", "minimum": 0},
    "exit_code": {
      "oneOf": [
        {"type": "integer"},
        {"type": "null"}
      ]
    },
    "command_record": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "output_artifacts": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "error": {
      "oneOf": [
        {"type": "string"},
        {"type": "null"}
      ]
    },
    "metadata": {"type": "object"}
  }
}
